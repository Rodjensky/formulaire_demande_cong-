# Application URL (Public URL)
APP_URL=http://localhost:3000

# Session Secret (Minimum 32 random characters for JWT encryption)
SESSION_SECRET=your-random-32-chars-session-secret-key-here

# Direct SMTP Configuration
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Service RH" <contact@yourdomain.com>
EMAIL_TO=contact@yourdomain.com
SECRETARY_EMAIL=secretary@yourdomain.com

# Resend (Alternative Email Provider)
RESEND_API_KEY=re_123456789_abcdef

# WhatsApp Business Cloud API (Meta Developers - Optional)
WHATSAPP_ACCESS_TOKEN=EAAG...your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Cloudflare Turnstile (Anti-Bot Verification)
TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Local Development SQLite Database Path (Optional, defaults to ./local.sqlite)
LOCAL_DB_PATH=./local.sqlite
